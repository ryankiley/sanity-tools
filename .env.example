# Anthropic API key — used by the AI metadata scripts (caption-images,
# generate-local-metadata, rewrite-captions). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Sanity auth: the scripts read the CLI token from
# ~/.config/sanity/config.json (populated by `sanity login`), not from
# .env. If you don't have a CLI token there, run `npx sanity login` from
# any Sanity project directory first. Set the token below ONLY if you
# want to override that behavior.
# SANITY_TOKEN=
