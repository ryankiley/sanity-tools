# Required: your Sanity project + dataset.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Optional: override the API version (defaults to 2024-01-01).
# SANITY_API_VERSION=2024-01-01

# Required for the AI scripts (caption-images, generate-local-metadata,
# rewrite-captions). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Sanity auth: scripts read the CLI token from ~/.config/sanity/config.json
# (populated by `npx sanity login`), not from this file. If you don't have
# a token there, run `npx sanity login` from any Sanity project directory.
